{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    // Main Agents
    "sisyphus": { // Claude Opus 4.6 Max
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "hephaestus": { // GPT 5.4 midium ~ high
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "prometheus": { // Claude Opus 4.6 Max
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "atlas": { // Claude Sonnet 4.6
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "oracle": { // GPT 5.4 max
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "explore": { // MiniMax M2.5
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max",
      // "model": "xai/grok-4.5",
      // "variant": "medium",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "librarian": { // MiniMax M2.5
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max",
      // "model": "xai/grok-4.5",
      // "variant": "medium",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "metis": { // Claude Opus 4.6
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "momus": { // GPT 5.4
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "multimodal-looker": { // Multi Modal
      "model": "xai/grok-4.5",
      // "model": "openai/gpt-5.5",
      // "model": "opencode-go/kimi-k2.7-code",
      "variant": "high",
      "fallback_models": [
        "opencode-go/kimi-k2.7-code",
        "openai/gpt-5.5",
        "opencode-go/qwen-3.6-plus"
      ]
    }
  },
  "categories": {
    // Quick, Small, Cheap
    "quick": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max",
      // "model": "xai/grok-4.5",
      // "variant": "medium",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "git": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max",
      // "model": "xai/grok-4.5",
      // "variant": "medium",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "unspecified-low": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max",
      // "model": "xai/grok-4.5",
      // "variant": "medium",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    // Smart, Heavy, Expensive
    "plan": {
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "deep": {
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "ultrabrain": {
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "unspecified-high": {
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "writing": {
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "visual-engineering": {
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "artistry": {
      "model": "xai/grok-4.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    }
  },
  "experimental": {
    "aggressive_truncation": true,
    "task_system": true
  },
  "tmux": {
    "enabled": false
  },
  "team_mode":{
    "enabled": true
  },
  "provider": {
    "zai-coding-plan": {
      "models": {
        "glm-5.1": {
          "limit": {
            "context": 100000
          }
        },
        "glm-5": {
          "limit": {
            "context": 100000
          }
        },
        "glm-5-turbo": {
          "limit": {
            "context": 100000
          }
        },
        "glm-5v-turbo": {
          "limit": {
            "context": 100000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}
