{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "zai-coding-plan/glm-5.2",
        "openai/gpt-5.4-mini"
      ]
    },
    "atlas": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "explore": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "metis": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.4-mini"
      ]
    }
  },
  "categories": {
    "quick": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "git": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "unspecified-low": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "plan": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "unspecified-high": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "writing": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "zai-coding-plan/glm-5.2"
      ]
    },
    "visual-engineering": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max",
      "fallback_models": [
        "openai/gpt-5.5"
      ]
    },
    "artistry": {
      "model": "zai-coding-plan/glm-5.2",
      "variant": "max",
      "fallback_models": [
        "openai/gpt-5.5"
      ]
    }
  },
  "experimental": {
    "aggressive_truncation": true,
    "task_system": true
  },
  "tmux": {
    "enabled": false
  },
  "team_mode":{
    "enabled": true
  }
}
