{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "fallback_models": [
        { "model": "zai-coding-plan/glm-5.2", "variant": "max" }
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
      "fallback_models": [
        { "model": "xai/grok-4.5", "variant": "high" },
        { "model": "zai-coding-plan/glm-5.2", "variant": "max" }
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.6-sol",
